#!/usr/bin/env bash
# Git pre-push hook: runs the full quality gate (build, tests, aislop included).
# Installed by setup-hooks.sh.
set -euo pipefail

# Locate check.sh: next to this hook (core.hooksPath install), then in the
# repo's dev-environment submodule (copied-hook install).
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
TOP="$(git rev-parse --show-toplevel)"
for candidate in "$HOOK_DIR/../check.sh" "$TOP/dev-environment/scripts/check.sh"; do
  if [ -f "$candidate" ]; then
    exec bash "$candidate" --project "$TOP"
  fi
done

echo "pre-push: dev-environment check.sh not found; skipping quality gate." >&2
exit 0
